{
  "manifest_version": 3,
  "name": "DesignBridge for Lanhu",
  "version": "0.3.2",
  "description": "Capture the current Lanhu design with the local DesignBridge app.",
  "key": "",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://lanhuapp.com/*",
    "https://*.lanhuapp.com/*",
    "https://lanhu.com/*",
    "https://*.lanhu.com/*"
  ],
  "action": {
    "default_title": "DesignBridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lanhuapp.com/*",
        "https://*.lanhuapp.com/*",
        "https://lanhu.com/*",
        "https://*.lanhu.com/*"
      ],
      "js": ["capture-page.js"],
      "run_at": "document_start"
    }
  ]
}
